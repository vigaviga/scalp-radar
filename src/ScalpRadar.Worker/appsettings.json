{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning",
        "Binance": "Warning",
        "CryptoExchange": "Warning",
        "ScalpRadar.Worker.Market.ForceOrderDebug": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext:l}: {Message:lj}{NewLine}{Exception}" } },
      {
        "Name": "File",
        "Args": {
          "path": "logs/scalpradar-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext:l}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "Telegram": {
    "Enabled": false,
    "BotToken": null,
    "ChatId": 0,
    "PollTimeoutSeconds": 30,
    "FeedDownSeconds": 120,
    "TopCount": 5,
    "DefaultStatsDays": 7
  },

  "Database": {
    "Host": "localhost",
    "Port": 5433,
    "Database": "scalpradar",
    "Username": "scalpradar",
    "Password": null,
    "LiquidationRetentionDays": 30,
    "LiquidationBatchSize": 200,
    "FlushIntervalSeconds": 5
  },

  "Universe": {
    "Size": 100,
    "MinQuoteVolumeUsd": 20000000,
    "MinListingAgeDays": 3,
    "QuoteAsset": "USDT",
    "ExcludedSymbols": [ "USDCUSDT", "FDUSDUSDT", "TUSDUSDT", "USDPUSDT", "BUSDUSDT", "DAIUSDT", "USD1USDT", "RLUSDUSDT", "USDEUSDT" ],
    "RefreshMinutes": 60,
    "DefaultFundingIntervalHours": 8,
    "BenchmarkSymbol": "BTCUSDT"
  },

  "Binance": {
    "MarkPriceUpdateMs": 3000,
    "OiPollSeconds": 30,
    "Backfill1mHours": 4,
    "Backfill5mHours": 24,
    "BackfillSpreadSeconds": 60,
    "BackfillMinDelayMs": 250,
    "RestWeightBudgetFraction": 0.5,
    "RestWeightCapFallback": 2400,
    "Default429BackoffSeconds": 60,
    "Default418BanSeconds": 300,
    "OiHistMaxRequestsPer5Min": 500,
    "StreamSubscribesPerSecond": 4,
    "StreamSubscribeBatchSize": 10,
    "SocketSubscriptionsCombineTarget": 50
  },

  "Engine": {
    "TickSeconds": 10,
    "ChannelCapacity": 200000,
    "LagWarnSeconds": 2,
    "LagLogSeconds": 60,
    "CandleCloseGraceMs": 1500
  },

  "State": {
    "Keep1mHours": 4,
    "Keep5mHours": 24,
    "KeepOiHours": 24,
    "PivotLeftBars": 2,
    "PivotRightBars": 2,
    "AtrPeriod": 14
  },

  "Heatmap": {
    "BucketWidthPct": 0.1,
    "LeverageMix": { "10": 0.30, "25": 0.30, "50": 0.25, "100": 0.15 },
    "MaintenanceMarginRate": 0.005,
    "LongShareMin": 0.2,
    "LongShareMax": 0.8,
    "HalfLifeHours": 24,
    "QueryNearPct": 0.3,
    "QueryFarPct": 3.0,
    "PruneBelowUsd": 100
  },

  "OrderBook": {
    "MaxBooks": 15,
    "MinMustHavesToShortlist": 3,
    "UnsubscribeAfterMinutes": 10,
    "UpdateIntervalMs": 500,
    "SnapshotWeight": 20,
    "SampleSeconds": 1,
    "ImbalanceRangePct": 0.5,
    "ImbalanceWindowSeconds": 30,
    "WallRangePct": 1.0,
    "WallMedianMultiple": 5.0,
    "WallMinHoldSeconds": 20,
    "MinHistorySeconds": 30,
    "MaxWaitForHistorySeconds": 30,
    "StartsPerMinute": 20
  },

  "Rules": {
    "VolumeWindowMinutes": 5,
    "VolumeBaselineHours": 4,
    "MinVolRatio": 2.5,
    "ShareWindowMinutes": 15,
    "MinDirectionalShare": 0.60,

    "OiLongWindowMinutes": 15,
    "OiShortWindowMinutes": 5,
    "MinOi15Pct": 1.0,
    "MinOi5Pct": 0.0,
    "FlatMovePct": 0.2,

    "MaxLongRate8hPct": 0.03,
    "MinShortRate8hPct": -0.03,
    "CrowdedLongsNotePct": 0.03,

    "CvdWindowMinutes": 15,
    "CvdShareWindowMinutes": 5,
    "MinCvd5Share": 0.10,

    "MinLiqRatio": 1.5,
    "MinImbalance": 0.20,

    "OpposingWallDistancePct": 0.3,
    "MaxChaseAtr": 1.5,
    "MaxSpreadPct": 0.05,
    "MaxTradeAgeSeconds": 10,
    "MaxOiAgeSeconds": 90,
    "MaxMarkAgeSeconds": 15,
    "MaxBookAgeSeconds": 5,
    "CooldownMinutes": 30,

    "MinConfirmations": 2,
    "StrongConfirmations": 3,
    "MustHaveScoreWeight": 10,
    "NearMissIntervalMinutes": 5,

    "MaxAlertsPerWindow": 8,
    "FloodWindowMinutes": 15
  },

  "Outcomes": {
    "TrackMinutes": 60,
    "Checkpoints": [ 5, 15, 60 ],
    "FinalizeGraceMinutes": 5
  }
}
